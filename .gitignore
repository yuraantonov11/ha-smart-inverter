# Per-inverter learning state — runtime data, not source.
# Narrow patterns: only the actual filenames the integration writes.
# ``**`` matches one or more path components; the previous ``*``
# pattern only matched a single level and missed
# ``hems/<entry_id>/real_forecast_pairs.json``.
hems/pv_fact_pairs_*.json
hems/pv_fact_pairs_*.json.tmp
hems/cloud_hourly_*.json
hems/cloud_hourly_*.json.tmp
hems/**/real_forecast_pairs.json
hems/**/real_forecast_pairs.json.tmp

# Test harness files —
# regenerated automatically by
# the test on every run. Not
# required for the integration
# to function. Do NOT commit.
tests/.harness/
tests/__pycache__/
